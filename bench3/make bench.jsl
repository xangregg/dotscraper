csv = Load Text File("data.csv");
csv;
header = "# x ticks: 1, 2
# y ticks: 30, 40, 50, 60, 70, 80, 90 
# x scale: linear, min=0.5, max=2.5
# y scale: linear, min=30, max=90
# plot area: left=70, top=30, width=546, height=442
";
// header uses 0D and CSV uses 0D0A -- not sure why
substitute into(header, "\!r", "\!r\!n");
Save Text File("data.csv", header || csv);

gb = Graph Builder(
	Size( 598, 511 ),
	Show Control Panel( 0 ),
	Show Legend( 0 ),
	Variables( X( :group ), Y( :Response ) ),
	Elements( Points( X, Y, Legend( 1 ), Jitter( "Beeswarm" ), Jitter Smooth( 0 ) ) ),
	SendToReport(
		Dispatch( {}, {:Response}, ScaleBox,
			{Min( 30 ), Max( 90 ), Minor Ticks( 1 )}
		),
		Dispatch( {}, "400", ScaleBox,
			{Legend Model( 1,
				Properties( 0,
					{Line Color( "blue" ), Marker Size( 6 ), Transparency( 0.7 )},
					Item ID( "Response", 1 )
				)
			)}
		)
	)
);

gb << save picture("dots-swarm.png", "png");
gb << close window;

