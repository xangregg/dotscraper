csv = Load Text File("data.csv");
csv;
header = "# x ticks: 65, 70, 75, 80, 85, 90, 95, 100
# y ticks: 30, 40, 50, 60, 70, 80, 90 
# x scale: linear, min=65, max=100
# y scale: linear, min=30, max=90
# plot area: left=70, top=30, width=546, height=436
";
// header uses 0D and CSV uses 0D0A -- not sure why
substitute into(header, "\!r", "\!r\!n");
Save Text File("data.csv", header || csv);

gb = Graph Builder(
	Size( 598, 511 ),
	Show Control Panel( 0 ),
	Show Legend( 0 ),
	Variables( X( :Score ), Y( :Response ) ),
	Elements( Points( X, Y, Legend( 1 ) ) ),
	SendToReport(
		Dispatch( {}, {:Score}, ScaleBox, {Min( 65 ), Max( 100 ), Inc( 5 ), Minor Ticks( 0 )}),
		Dispatch( {}, {:Response}, ScaleBox, {Min( 30 ), Max( 90 ), Inc( 10 ), Minor Ticks( 0 )} ),
		Dispatch( {}, "400", ScaleBox,
			{Legend Model( 1,
				Properties( 0,
					{Marker Size( 3 ), Transparency( 0.33 )},
					Item ID( "Response", 1 )
				)
			)}
		)
	)
);

gb << save picture("tiny-dots.png", "png");
gb << close window;

